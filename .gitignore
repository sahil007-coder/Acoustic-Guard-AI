# ==============================================================================
# AcousticGuard AI - .gitignore
# Stack: Python, TensorFlow/Keras, Librosa, NumPy, Flask, React/PWA, Audio Data
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller & specs
*.manifest
*.spec

# Unit test & coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook & IPython
.ipynb_checkpoints
*/.ipynb_checkpoints/*
.ipython/
profile_default/
ipython_config.py

# Virtual Environments (venv, conda, pipenv)
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
conda-env/
.conda/

# Audio Datasets & Raw/Processed Data
# (Prevent checking heavy raw audio clips & preprocessed tensors into git)
data/raw/
data/processed/
data/interim/
datasets/
ESC-50/
ESC-50-master/
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.aac
*.npy
*.npz
*.tar.gz
*.zip
*.rar
*.7z

# Whitelist reference test samples & keepers
!samples/
!samples/*.wav
!data/**/.gitkeep
!models/**/.gitkeep

# Machine Learning Models, Weights, and Checkpoints
models/*.h5
models/*.keras
models/*.tflite
models/*.pb
models/variables/
*.h5
*.keras
*.ckpt

# Whitelist trained AcousticGuard production model
!models/acousticguard.keras
*.pt
*.pth
*.onnx
*.tflite
saved_models/
checkpoints/
runs/
wandb/
tensorboard_logs/

# Frontend / PWA (Node.js, React, Vite)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/

# Environment Variables & Secrets
.env
.env*.local
!.env.example
*.pem
*.key
*.cert

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
*.sublime-workspace
*.sublime-project
.project
.settings/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Temporary files & Logs
*.log
logs/
temp/
tmp/
